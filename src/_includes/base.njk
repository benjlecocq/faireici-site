<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seo.titre }}</title>
<meta name="description" content="{{ seo.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ seo.type or 'website' }}">
<meta property="og:site_name" content="fair[e]ici">
<meta property="og:locale" content="fr_FR">
<meta property="og:title" content="{{ seo.titre }}">
<meta property="og:description" content="{{ seo.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ seo.image or '/assets/vue-territoire.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0d0d0e">
<script>try{if(localStorage.getItem("fi-theme")==="light")document.documentElement.dataset.theme="light"}catch(e){}</script>
<link rel="icon" href="/assets/logo-v2.png">
{% block head %}{% endblock %}
<link rel="stylesheet" href="/styles/faire-ici.css">
<style>.fi-strong{font-weight:500;color:var(--paper)}
{% block style %}{% endblock %}</style>
</head>
<body data-page="{{ bodyPage }}" data-motion="off">
<header class="site-head" data-scrolled="false">
<a class="brand" href="/" aria-label="fair[e]ici accueil"><span class="logo-word">fair[e]ici!</span></a>
<nav class="nav" aria-label="Navigation principale">
<a href="/conviction.html"{% if navKey == 'conviction' %} aria-current="page"{% endif %}>Conviction</a>
<div class="has-menu">
<a href="/{{ exp[0].page }}.html"{% if navKey == 'expertises' %} aria-current="page"{% endif %}>Expertises</a>
<div class="submenu" role="menu">{% for e in exp %}
<a href="/{{ e.page }}.html"><span class="num">{{ e.num }}</span> {{ e.nom }}</a>{% endfor %}
</div>
</div>
<a href="/realisations.html"{% if navKey == 'realisations' %} aria-current="page"{% endif %}>Réalisations</a>
<a href="/equipe.html"{% if navKey == 'ressources' %} aria-current="page"{% endif %}>Équipe</a>
<a href="/contact.html"{% if navKey == 'contact' %} aria-current="page"{% endif %}>Contact</a>
</nav>
<div class="head-cta">
<button class="theme-toggle" type="button" aria-label="Passer en thème clair" title="Thème clair / sombre"><svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
<a href="/contact.html" class="btn btn--solid">Parlons-nous <span class="arrow">→</span></a>
<button class="burger" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
</div>
</header>
<div class="drawer" aria-hidden="true">
<a href="/conviction.html"><span class="num">01</span> Conviction</a>
<div class="drawer-sub">{% for e in exp %}
<a href="/{{ e.page }}.html">{{ e.nom }}</a>{% endfor %}
</div>
<a href="/realisations.html"><span class="num">02</span> Réalisations</a>
<a href="/equipe.html"><span class="num">03</span> Équipe</a>
<a href="/contact.html"><span class="num">04</span> Contact</a>
</div>
<main>
{% block main %}{% endblock %}
</main>
{% block aftermain %}{% endblock %}
<footer class="site-foot">
<div class="wrap">
<div class="foot-top">
<div>
<p class="foot-sig-name"><span class="logo-word">fair[e]ici!</span></p>
<p class="foot-sig">Révéler<span>·</span>Mobiliser<span>·</span>Concevoir<br>Expérimenter<span>·</span>Déployer</p>
</div>
<div class="foot-col foot-col--nav">
<h4>Naviguer</h4>
<a href="/">Accueil</a>
<a href="/conviction.html">Conviction</a>
<a href="/{{ exp[0].page }}.html">Expertises</a>
<a href="/realisations.html">Réalisations</a>
<a href="/equipe.html">Équipe</a>
<a href="/contact.html">Contact</a>
</div>
<div class="foot-col">
<h4>Contact</h4>
<a href="/contact.html">Parlons de votre projet</a>
<a href="mailto:{{ site.email }}">{{ site.email }}</a>
<a href="tel:{{ site.telephone_fixe or '+33975704016' }}">{{ site.telephone_fixe_affiche or '09 75 70 40 16' }}</a>
</div>
</div>
<div class="foot-bottom">
<span>© {{ annee }} <span class="brand-word">fair[e]ici!</span> - Développement territorial</span>
<a href="/mentions-legales.html">Mentions légales</a>
</div>
</div>
</footer>
<script>(function(){var r=document.documentElement,b=document.querySelector(".theme-toggle"),m=document.querySelector('meta[name="theme-color"]');function s(){var l=r.dataset.theme==="light";b.setAttribute("aria-label",l?"Passer en thème sombre":"Passer en thème clair");m&&m.setAttribute("content",l?"#f4f0eb":"#0d0d0e");}s();b.addEventListener("click",function(){var l=r.dataset.theme!=="light";if(l)r.dataset.theme="light";else delete r.dataset.theme;try{localStorage.setItem("fi-theme",l?"light":"dark")}catch(e){}s();});})();</script>
<script src="/scripts/site.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
