---
pagination:
  data: "collections.projets"
  size: 1
  alias: "r"
  addAllPagesToCollections: true
permalink: "realisations/{{ r.data.slug }}.html"
navKey: "realisations"
bodyPage: "reference"
---
{% extends "base.njk" %}
{% set d = r.data %}
{% set seo = { titre: d.client + ' - ' + d.titre + ' - fair[e]ici', description: d.description_seo or (d.contexte | excerpt), image: (d.image | img), type: 'article' } %}
{% block head %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"CreativeWork","name":{{ d.titre | json | safe }},"dateCreated":{{ (d.annee | string) | json | safe }},"locationCreated":{"@type":"Place","name":{{ d.localite | json | safe }}},"provider":{"@type":"ProfessionalService","name":"fair[e]ici","url":{{ (site.url + '/') | json | safe }}},"sourceOrganization":{"@type":"Organization","name":{{ d.client | json | safe }}},"url":{{ (site.url + page.url) | json | safe }},"image":{{ (site.url + d.image) | json | safe }}}</script>{% endblock %}
{% block style %}{% raw %}
.ref-hero { padding-top: clamp(120px,14vh,180px); padding-bottom: clamp(20px,2.6vw,34px); }
.ref-client { font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.04em; color: var(--accent); }
.ref-title { font-size: clamp(1.7rem, 3.2vw, 2.5rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; max-width: 30ch; margin-top: 12px; }
.ref-partners { font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); margin-top: 12px; }
.ref-meta { display: flex; flex-wrap: wrap; gap: clamp(18px,3vw,40px); padding: 18px 0; margin-top: clamp(20px,2.6vw,30px); border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
.ref-meta dt { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
.ref-meta dd { margin: 5px 0 0; font-size: 0.98rem; color: var(--paper); }
.ref-media { margin-top: clamp(22px,3vw,34px); border-radius: 8px; overflow: hidden; background: var(--ink-2); }
.ref-media img { display: block; width: 100%; height: auto; }
.ref-body { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px,5vw,72px); align-items: start; }
.ref-body h2 { font-family: var(--font-mono); font-weight: 400; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
.ref-body p { color: var(--paper-dim); font-size: 1.0625rem; line-height: 1.6; }
.ref-body p + p { margin-top: 0.55em; }
.ref-phase { font-family: var(--font-body); font-weight: 600; font-size: 1rem; color: var(--paper); margin: 18px 0 8px; }
.ref-phase:first-of-type { margin-top: 0; }
.ref-rich strong { color: var(--paper); font-weight: 600; }
.ref-rich ul { list-style: none; margin: 0.55em 0 0; padding: 0; }
.ref-rich ul:first-child { margin-top: 0; }
.ref-rich p + ul { margin-top: 8px; }
.ref-rich ul + p { margin-top: 18px; }
.ref-rich li p { margin: 0; }
.ref-rich li + li, .ref-steps li + li { margin-top: 10px; }
.ref-rich li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
.ref-steps { list-style: none; margin: 0; padding: 0; }
.ref-rich li, .ref-steps li { position: relative; padding-left: 18px; font-size: 1.0625rem; line-height: 1.5; color: var(--paper-dim); }
.ref-steps li + li { margin-top: 10px; }
.ref-steps li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
.ref-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(28px,4vw,44px); }
.ref-tags a { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.04em; color: var(--paper-dim); border: 1px solid var(--line); border-radius: 999px; padding: 0.6em 1.05em; transition: border-color .25s var(--ease), color .25s var(--ease); }
.ref-tags a:hover { border-color: var(--accent); color: var(--paper); }
.ref-back { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: inline-flex; gap: 8px; transition: color .25s var(--ease); }
.ref-back:hover { color: var(--accent); }
@media (max-width: 860px){ .ref-body { grid-template-columns: 1fr; } }
{% endraw %}
.ref-actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px 28px;margin-top:clamp(24px,3vw,36px)}{% endblock %}
{% block main %}
<section class="ref-hero wrap">
<nav class="filters" aria-label="Filtrer les réalisations" style="margin-bottom:clamp(22px,2.6vw,32px)">
<a class="filter" href="/realisations.html">Tout voir<span class="count">{{ collections.projets.length }}</span></a>{% for e in exp %}
<a class="filter" href="/realisations.html?f={{ e.key }}"{% if d.expertises and e.key in d.expertises %} aria-current="true"{% endif %}>{{ e.nom }}<span class="count">{{ collections.projets | expCount(e.key) }}</span></a>{% endfor %}
</nav>
<p class="crumb"><a href="/">Accueil</a><span class="sep">/</span><a href="/realisations.html">Réalisations</a><span class="sep">/</span><span>{{ d.client }}</span></p>
<p class="ref-client mt-s">{{ d.client }}</p>
<h1 class="ref-title">{{ d.titre }}</h1>
{% if d.partenaires %}<p class="ref-partners">En partenariat avec {{ d.partenaires }}</p>{% endif %}
<dl class="ref-meta">
{% if d.annee %}<div class="ref-meta__cell"><dt>Année</dt><dd>{{ d.annee }}</dd></div>{% endif %}
{% if d.budget %}<div class="ref-meta__cell"><dt>Budget</dt><dd>{{ d.budget }}</dd></div>{% endif %}
{% if d.contact_client %}<div class="ref-meta__cell"><dt>Contact client</dt><dd>{{ d.contact_client }}</dd></div>{% endif %}
{% if d.localite %}<div class="ref-meta__cell"><dt>Localité</dt><dd>{{ d.localite }}</dd></div>{% endif %}
</dl>
{% if d.image %}<div class="ref-media"><img src="{{ d.image | img }}" alt="{{ d.titre }}"></div>{% endif %}
</section>
<section class="section section--tight">
<div class="wrap ref-body">
<div>
<h2>Contexte &amp; Objectifs</h2>
<div class="ref-rich">{{ d.contexte | rich | safe }}</div>
</div>
<div>
<h2>Méthodologie</h2>
<div class="ref-rich">{{ d.methodo | rich | safe }}</div>
</div>
</div>
<div class="wrap">
<div class="ref-tags">{% for k in d.expertises %}{% for e in exp %}{% if e.key == k %}<a href="/{{ e.page }}.html">{{ e.nom }}</a>{% endif %}{% endfor %}{% endfor %}</div>
<div class="ref-actions">
{% if d.pdf %}<a class="btn" href="{{ d.pdf }}" target="_blank" rel="noopener">Télécharger la fiche PDF <span class="arrow">↓</span></a>{% endif %}
<a class="btn btn--solid" href="/contact.html">Parlons de votre projet <span class="arrow">→</span></a>
<a class="ref-back" href="/realisations.html">← Toutes les réalisations</a>
</div>
</div>
</section>
{% endblock %}
