---
permalink: "/"
navKey: "accueil"
bodyPage: "home"
---
{% extends "base.njk" %}
{% set seo = { titre: accueil.seo_titre, description: accueil.seo_description } %}
{% block head %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"ProfessionalService","name":"fair[e]ici","description":"Conseil en développement territorial : résilience économique, attractivité, offre d'accueil, programmation urbaine, entrepreneuriat et ESS.","url":{{ (site.url + '/') | json | safe }},"email":{{ site.email | json | safe }},"telephone":{{ site.telephone | json | safe }},"address":[{% for a in site.adresses %}{"@type":"PostalAddress","name":{{ a.libelle | json | safe }},"streetAddress":{{ a.rue | json | safe }},"postalCode":{{ a.code_postal | json | safe }},"addressLocality":{{ a.ville | json | safe }},"addressCountry":"FR"}{% if not loop.last %},{% endif %}{% endfor %}],"areaServed":{"@type":"Country","name":"France"},"founder":[{"@type":"Person","name":"Vincent Lecomte"},{"@type":"Person","name":"Benjamin Lecocq"}],"knowsAbout":["développement territorial","attractivité territoriale","programmation urbaine","économie sociale et solidaire","stratégie foncière","résilience économique"]}</script>{% endblock %}
{% block style %}{% raw %}
/* ============ HOME-SPECIFIC ============ */

/* hero shell */
.hero { min-height: 100svh; display: flex; align-items: center; padding-top: 110px; padding-bottom: clamp(32px, 4vw, 56px); position: relative; }
[data-hero-block] { display: none !important; }
html[data-hero="a"] [data-hero-block="a"],
html[data-hero="b"] [data-hero-block="b"] { display: block !important; }
html[data-hero="c"] [data-hero-block="c"] { display: flex !important; }

/* ---- Variant A - Manifeste ---- */
.heroA { width: 100%; }
.heroA__head { font-size: clamp(2.5rem, 6.2vw, 5.7rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.035em; max-width: 17ch; }
.heroA__foot { display: grid; grid-template-columns: 1fr auto; gap: clamp(28px,5vw,80px); align-items: end; margin-top: clamp(40px,5vw,72px); }
.heroA__foot .lede { max-width: 42ch; }
.heroA__cta { display: flex; gap: 14px; flex-wrap: wrap; }

/* ---- Variant B - Éditorial split ---- */
.heroB { width: 100%; }
.heroB__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px,5vw,80px); align-items: end; }
.heroB__head { font-size: clamp(2.6rem, 6.4vw, 5.6rem); font-weight: 500; line-height: 0.99; letter-spacing: -0.03em; }
.heroB__media { position: relative; }
.heroB__media .ph { height: clamp(360px, 52vw, 620px); border-radius: 6px; }
.carousel{position:relative;height:clamp(360px,52vw,620px);border-radius:6px;overflow:hidden;}
.carousel__track{display:flex;height:100%;transition:transform .55s var(--ease);}
.carousel__slide{flex:0 0 100%;height:100%;border-radius:0;aspect-ratio:auto;}
.carousel__btn{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:var(--paper);background:rgba(13,13,14,.55);border:1px solid rgba(242,237,233,.25);backdrop-filter:blur(4px);cursor:pointer;z-index:3;transition:background .25s var(--ease),border-color .25s var(--ease);}
.carousel__btn:hover{background:var(--accent);border-color:var(--accent);}
.carousel__btn--prev{left:14px;}.carousel__btn--next{right:14px;}
.carousel__dots{position:absolute;left:0;right:0;bottom:14px;display:flex;justify-content:center;gap:8px;z-index:3;}
.carousel__dots button{width:8px;height:8px;border-radius:50%;padding:0;border:0;background:rgba(242,237,233,.4);cursor:pointer;transition:background .25s var(--ease),width .25s var(--ease);}
.carousel__dots button[aria-current="true"]{background:var(--accent);width:22px;border-radius:4px;}
.heroB__meta { display: flex; justify-content: space-between; margin-top: 16px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.heroB__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: clamp(28px,3vw,40px); }

/* ---- Variant C - Cinétique ---- */
.heroC { width: 100%; text-align: center; flex-direction: column; align-items: center; gap: clamp(28px,4vw,48px); }
.heroC__head { font-size: clamp(2.5rem, 5.8vw, 5.4rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.035em; max-width: 18ch; }
.heroC .lede { margin-inline: auto; text-align: center; max-width: 52ch; }
.heroC__kw { width: 100%; margin-top: 8px; }
.heroC__cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

.hero-scroll { position: absolute; right: var(--gutter); bottom: clamp(28px,4vw,48px); display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
html[data-hero="b"] .hero-scroll { display: none; }
.hero-scroll .bar { width: 1px; height: 42px; background: linear-gradient(var(--accent), transparent); position: relative; overflow: hidden; }
@media (prefers-reduced-motion: no-preference) { .hero-scroll .bar::after { content:""; position:absolute; inset:0; background: var(--accent); animation: scrolldown 2s var(--ease) infinite; } }
@keyframes scrolldown { 0%{transform:translateY(-100%)} 60%,100%{transform:translateY(100%)} }

/* mission */
.mission__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,6vw,90px); align-items: start; }
.mission__statement { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 2.2vw, 1.9rem); line-height: 1.16; letter-spacing: -0.015em; max-width: 26ch; }
.mission__statement em { font-style: normal; color: var(--accent); }
.mission__body { max-width: 52ch; }
.mission__body p,
.lead-copy { color: var(--paper-dim); font-size: clamp(1.12rem, 1.45vw, 1.35rem); line-height: 1.55; }

/* context / tensions */
.tensions { border-top: 1px solid var(--line); margin-top: clamp(36px,4vw,56px); }
.tension { display: grid; grid-template-columns: 56px 1fr; gap: clamp(16px,3vw,40px); align-items: center; padding: clamp(20px,2.4vw,30px) 0; border-bottom: 1px solid var(--line); }
.tension__pair { display: flex; align-items: center; gap: clamp(14px,2.4vw,32px); flex-wrap: wrap; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.35rem, 3.2vw, 2.5rem); letter-spacing: -0.02em; line-height: 1.05; }
.tension__vs { color: var(--accent); font-family: var(--font-mono); font-weight: 400; font-size: clamp(0.85rem,1.4vw,1.05rem); transform: translateY(-0.1em); }
.tension:hover .tension__pair { color: var(--paper); }
.tension .num { align-self: start; padding-top: 0.55em; }

/* expertises list - compact, line-free */
.exp-list { }
.exp-row { display: grid; grid-template-columns: 40px 1fr auto; gap: clamp(12px,1.8vw,26px); align-items: center; padding: clamp(11px,1.3vw,15px) clamp(12px,1.6vw,18px); border-radius: 12px; position: relative; transition: background .3s var(--ease); }
.exp-row + .exp-row { margin-top: 2px; }
.exp-row__cell { min-width: 0; display: flex; flex-direction: column; }
.exp-row__title { display: block; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.02rem, 1.35vw, 1.22rem); letter-spacing: -0.02em; line-height: 1.12; transition: color .3s var(--ease); }
.exp-row__desc { display: block; color: var(--muted); max-width: 60ch; font-size: clamp(0.84rem,0.95vw,0.92rem); line-height: 1.45; margin-top: 3px; transition: color .3s var(--ease); }
.exp-row__arrow { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; flex: none; transition: background .4s var(--ease), border-color .4s var(--ease), transform .5s var(--ease); }
.exp-row .num { transition: color .3s var(--ease); align-self: start; padding-top: 0.2em; }
.exp-row:hover { background: var(--ink-2); }
.exp-row:hover .exp-row__title { color: var(--accent); }
.exp-row:hover .num { color: var(--accent); }
.exp-row:hover .exp-row__arrow { background: var(--accent); border-color: var(--accent); transform: rotate(45deg); }
.exp-row:hover .exp-row__arrow svg { stroke: #fff; }

/* cta band */
.context-list { list-style: none; max-width: 42ch; margin-top: 20px; }
.context-list li { font-family: var(--font-body); font-size: clamp(0.98rem, 1.15vw, 1.08rem); line-height: 1.45; color: var(--paper-dim); padding-left: 18px; position: relative; }
.context-list li + li { margin-top: 7px; }
.context-list li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
.context-list .amp { color: var(--accent); font-family: var(--font-mono); margin: 0 0.12em; font-size: 0.9em; }
.cta-band { text-align: center; }
.cta-band h2 { font-size: clamp(2.2rem, 6vw, 5rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; max-width: 18ch; margin-inline: auto; }

@media (max-width: 900px) {
  .heroA__foot, .heroB__grid, .mission__grid { grid-template-columns: 1fr; }
  .heroA__foot { gap: 28px; }
  .heroB__media { order: -1; }
  .tension { grid-template-columns: 38px 1fr; }
  .exp-row { grid-template-columns: 40px 1fr; }
  .exp-row__arrow { display: none; }
  .hero-scroll { display: none; }
}
{% endraw %}{% endblock %}
{% block main %}
<section class="hero wrap">
<div class="heroB">
<div class="heroB__grid">
<div>
<p class="eyebrow" data-reveal>{{ accueil.hero_surtitre }}</p>
<h1 class="heroB__head mt-s" data-reveal data-reveal-delay="1">{{ accueil.hero_titre | fi | safe }}</h1>
<p class="lede mt-s" data-reveal data-reveal-delay="2">{{ accueil.hero_texte | fi | safe }}</p>
<div class="heroB__cta" data-reveal data-reveal-delay="3">
<a href="/contact.html" class="btn btn--solid">{{ accueil.hero_bouton }} <span class="arrow">→</span></a>
</div>
</div>
<div class="heroB__media" data-reveal data-reveal-delay="2">
<div class="carousel" id="heroCarousel" aria-roledescription="carrousel" aria-label="Photos de territoires">
<div class="carousel__track">{% for s in accueil.carrousel %}
<div class="carousel__slide ph ph--tall ph--filled"><img src="{{ s.image }}" alt="{{ s.alt }}" decoding="async"></div>{% endfor %}
</div>
{% if accueil.carrousel.length > 1 %}<button class="carousel__btn carousel__btn--prev" type="button" aria-label="Photo précédente"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 3L5 8l5 5"/></svg></button>
<button class="carousel__btn carousel__btn--next" type="button" aria-label="Photo suivante"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5"/></svg></button>
<div class="carousel__dots"></div>{% endif %}
</div>
</div>
</div>
</div>
</section>
<section class="section">
<div class="wrap mission__grid">
<div data-reveal>
<p class="eyebrow">{{ accueil.role_surtitre }}</p>
<p class="mission__statement mt-s">{{ accueil.role_titre | fi | safe }}</p>
</div>
<div class="mission__body" data-reveal data-reveal-delay="1">{{ accueil.role_texte | paras | safe }}</div>
</div>
</section>
<section class="section section--tight">
<div class="wrap">
<div class="split split--top">
<div data-reveal>
<p class="eyebrow">{{ accueil.contexte_surtitre }}</p>
<h2 class="h-xl mt-s">{{ accueil.contexte_titre | fi | safe }}</h2>
<p class="h-xl mt-s" data-reveal>{{ accueil.contexte_titre2 | fi | safe }}</p>
</div>
<div data-reveal data-reveal-delay="1">
<p class="dim max-46 lead-copy">{{ accueil.contexte_texte | fi | safe }}</p>
<ul class="context-list mt-s">{% for li in accueil.contexte_liste %}
<li>{{ li | fi | amp | safe }}</li>{% endfor %}
</ul>
</div>
</div>
</div>
</section>
<section class="section">
<div class="wrap">
<div class="split split--top" style="margin-bottom: clamp(32px,4vw,56px)">
<div data-reveal>
<p class="eyebrow">{{ accueil.expertises_surtitre }}</p>
<h2 class="h-xl mt-s">{{ accueil.expertises_titre | fi | safe }}</h2>
</div>
<div data-reveal data-reveal-delay="1" style="display:flex;align-items:flex-end">
<p class="dim max-46 lead-copy">{{ accueil.expertises_texte | fi | safe }}</p>
</div>
</div>
<div class="exp-list">{% for e in exp %}
<a class="exp-row" href="/{{ e.page }}.html" data-reveal>
<span class="num">{{ e.num }}</span>
<span class="exp-row__cell"><span class="exp-row__title">{{ e.nom }}</span><span class="exp-row__desc">{{ e.description | fi | safe }}</span></span>
<span class="exp-row__arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--paper)" stroke-width="1.5"><path d="M3 13L13 3M13 3H5M13 3V11"/></svg></span>
</a>{% endfor %}
</div>
</div>
</section>
{% set derniers = collections.projets | recent('', 3) %}{% if derniers.length %}<section class="section section--tight">
<div class="wrap">
<div data-reveal style="margin-bottom: clamp(32px,4vw,56px)">
<p class="eyebrow">Réalisations</p>
<h2 class="h-xl mt-s">Nos dernières <span class="bracket">[réalisations]</span></h2>
</div>
<div class="proj-grid">{% for r in derniers %}
<a class="card" href="/realisations/{{ r.data.slug }}.html" data-reveal>{% if r.data.image %}<img src="{{ r.data.image | img }}" alt="{{ r.data.titre }}" loading="lazy">{% endif %}<span class="card__arrow"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.5"><path d="M3 13L13 3M13 3H5M13 3V11"/></svg></span><span class="card__body"><span class="card__title">{{ r.data.titre }}</span><span class="card__client">{{ r.data.client }}</span></span></a>{% endfor %}
</div>
<div class="proj-more" data-reveal><a href="/realisations.html" class="btn">Autres réalisations <span class="arrow">→</span></a></div>
</div>
</section>{% endif %}
{% endblock %}
{% block scripts %}{% if accueil.carrousel.length > 1 %}{% raw %}<script>
(function(){
  var c=document.getElementById('heroCarousel'); if(!c) return;
  var track=c.querySelector('.carousel__track'), slides=c.querySelectorAll('.carousel__slide'), dots=c.querySelector('.carousel__dots'), i=0, n=slides.length;
  for(var k=0;k<n;k++){ var d=document.createElement('button'); d.type='button'; d.setAttribute('aria-label','Photo '+(k+1)); (function(k){d.addEventListener('click',function(){go(k);});})(k); dots.appendChild(d); }
  function go(k){ i=(k+n)%n; track.style.transform='translateX('+(-100*i)+'%)'; [].forEach.call(dots.children,function(d,j){d.setAttribute('aria-current', j===i?'true':'false');}); }
  c.querySelector('.carousel__btn--prev').addEventListener('click',function(){go(i-1);});
  c.querySelector('.carousel__btn--next').addEventListener('click',function(){go(i+1);});
  var x0=null; c.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
  c.addEventListener('touchend',function(e){ if(x0===null) return; var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>40) go(i+(dx<0?1:-1)); x0=null; });
  go(0);
  var t=null; function play(){ stop(); t=setInterval(function(){go(i+1);},5000); } function stop(){ if(t) clearInterval(t); t=null; }
  c.addEventListener('mouseenter',stop); c.addEventListener('mouseleave',play);
  [].forEach.call(c.querySelectorAll('button'),function(b){b.addEventListener('click',play);});
  document.addEventListener('visibilitychange',function(){ document.hidden?stop():play(); });
  play();
})();
</script>{% endraw %}{% endif %}{% endblock %}
