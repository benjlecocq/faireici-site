---
permalink: "/"
navKey: "accueil"
bodyPage: "home"
---
{% extends "base.njk" %}
{% set seo = { titre: accueil.seo_titre, description: accueil.seo_description } %}
{% block head %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"ProfessionalService","name":"fair[e]ici","description":"Conseil en développement territorial : résilience économique, attractivité, offre d'accueil, programmation urbaine, entrepreneuriat et ESS.","url":{{ (site.url + '/') | json | safe }},"email":{{ site.email | json | safe }},"telephone":{{ site.telephone | json | safe }},"address":[{% for a in site.adresses %}{"@type":"PostalAddress","name":{{ a.libelle | json | safe }},"streetAddress":{{ a.rue | json | safe }},"postalCode":{{ a.code_postal | json | safe }},"addressLocality":{{ a.ville | json | safe }},"addressCountry":"FR"}{% if not loop.last %},{% endif %}{% endfor %}],"areaServed":{"@type":"Country","name":"France"},"founder":[{"@type":"Person","name":"Vincent Lecomte"},{"@type":"Person","name":"Benjamin Lecocq"}],"knowsAbout":["développement territorial","attractivité territoriale","programmation urbaine","économie sociale et solidaire","stratégie foncière","résilience économique"]}</script>{% endblock %}
{% block style %}{% raw %}
.hero { display: block; padding-top: clamp(150px, 18vh, 230px); padding-bottom: clamp(56px, 7vw, 100px); position: relative; }
.heroB { width: 100%; }
.heroB__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px,5vw,80px); align-items: end; }
.heroB__head { font-size: clamp(2.6rem, 6.4vw, 5.6rem); font-weight: 500; line-height: 0.99; letter-spacing: -0.03em; }
.heroB__media { position: relative; }
.carousel{position:relative;height:clamp(360px,48vw,580px);border-radius:6px;overflow:hidden;}
.carousel__track{display:flex;height:100%;transition:transform .55s var(--ease);}
.carousel__slide{flex:0 0 100%;height:100%;border-radius:0;aspect-ratio:auto;}
.carousel__btn{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:var(--paper);background:rgba(13,13,14,.55);border:1px solid rgba(242,237,233,.25);backdrop-filter:blur(4px);cursor:pointer;z-index:3;transition:background .25s var(--ease),border-color .25s var(--ease);}
.carousel__btn:hover{background:var(--accent);border-color:var(--accent);}
.carousel__btn--prev{left:14px;}.carousel__btn--next{right:14px;}
.carousel__dots{position:absolute;left:0;right:0;bottom:14px;display:flex;justify-content:center;gap:8px;z-index:3;}
.carousel__dots button{width:8px;height:8px;border-radius:50%;padding:0;border:0;background:rgba(242,237,233,.4);cursor:pointer;transition:background .25s var(--ease),width .25s var(--ease);}
.carousel__dots button[aria-current="true"]{background:var(--accent);width:22px;border-radius:4px;}
.heroB__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: clamp(28px,3vw,40px); }
.role{text-align:center;padding-block:clamp(90px,12vw,180px)}
.role .eyebrow{justify-content:center}
.role__statement{font-family:var(--font-display);font-weight:500;font-size:clamp(1.8rem,3.4vw,3rem);line-height:1.1;letter-spacing:-0.03em;max-width:22ch;margin:clamp(24px,3vw,36px) auto 0;text-wrap:balance}
.role__statement em{font-style:normal;color:var(--accent)}
.role__body{max-width:62ch;margin:clamp(28px,3vw,40px) auto 0}
.role__body p{color:var(--paper-dim);font-size:clamp(1.05rem,1.3vw,1.2rem);line-height:1.6}
.role__body p + p{margin-top:.6em}
.ctx__top,.xp__head{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,90px);align-items:end}
.ctx__title,.xp__title{font-family:var(--font-display);font-weight:500;font-size:clamp(1.8rem,3.2vw,2.7rem);line-height:1.08;letter-spacing:-0.025em}
.ctx__text{color:var(--paper-dim);font-size:clamp(1.05rem,1.3vw,1.2rem);line-height:1.55;max-width:46ch}
.ctx__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,6vw,96px);align-items:start}
.ctx__big{font-family:var(--font-display);font-weight:500;font-size:clamp(2rem,4vw,3.4rem);line-height:1.02;letter-spacing:-0.03em;margin-top:18px}
.ctx__grid .ctx__text{margin-top:22px;max-width:40ch}
.tens{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.ten{display:grid;grid-template-columns:28px 1fr;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--line);font-family:var(--font-display);font-weight:500;font-size:clamp(1.1rem,1.5vw,1.35rem);letter-spacing:-0.015em;line-height:1.25;color:var(--paper)}
.ten::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);transform:translateY(-2px)}
.ten__amp{color:var(--accent);margin:0 .2em}
.ctx__end{margin-top:clamp(20px,2.2vw,28px);font-family:var(--font-display);font-weight:500;font-size:clamp(1rem,1.2vw,1.12rem);letter-spacing:-0.01em;line-height:1.4;color:var(--paper-dim);max-width:40ch}
.xp{padding-block:clamp(80px,10vw,150px)}
.xp__head{margin-bottom:clamp(40px,5vw,72px)}
.xp-row{display:grid;grid-template-columns:clamp(80px,9vw,140px) minmax(0,1fr) auto;gap:clamp(16px,2.4vw,36px);align-items:center;padding:clamp(18px,2vw,28px) 0;border-top:1px solid var(--line-soft);transition:padding .35s var(--ease)}
.xp-row:last-child{border-bottom:1px solid var(--line-soft)}
.xp-row__n{font-family:var(--font-display);font-weight:500;font-size:clamp(2rem,3.4vw,3rem);line-height:.9;letter-spacing:-0.04em;color:var(--accent)}
.xp-row__t{font-family:var(--font-display);font-weight:500;font-size:clamp(1.15rem,1.6vw,1.45rem);letter-spacing:-0.02em;line-height:1.1;display:block;transition:color .3s var(--ease)}
.xp-row__d{display:block;color:var(--muted);font-size:clamp(.9rem,1vw,1rem);line-height:1.45;margin-top:6px;max-width:62ch}
.xp-row__a{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;transition:background .4s var(--ease),border-color .4s var(--ease),transform .5s var(--ease)}
.xp-row:hover{padding-left:12px}.xp-row:hover .xp-row__t{color:var(--accent)}
.xp-row:hover .xp-row__a{background:var(--accent);border-color:var(--accent);transform:rotate(45deg)}
.xp-row:hover .xp-row__a svg{stroke:#fff}
.last{padding-bottom:clamp(80px,10vw,140px)}
.last__head{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(32px,4vw,52px)}
@media (max-width:900px){.heroB__grid,.ctx__top,.xp__head{grid-template-columns:1fr}.heroB__media{order:-1}.ctx__grid{grid-template-columns:1fr}.xp-row{grid-template-columns:64px minmax(0,1fr)}.xp-row__a{display:none}}
{% endraw %}{% endblock %}
{% block main %}
<section class="hero wrap">
<div class="heroB">
<div class="heroB__grid">
<div>
<p class="eyebrow" data-reveal>{{ accueil.hero_surtitre }}</p>
<h1 class="heroB__head mt-s" data-reveal data-reveal-delay="1">{{ accueil.hero_titre | fi | safe }}</h1>
<p class="lede mt-s" data-reveal data-reveal-delay="2">{{ accueil.hero_texte | fi | safe }}</p>
<div class="heroB__cta" data-reveal data-reveal-delay="3">
<a href="/contact.html" class="btn btn--solid">{{ accueil.hero_bouton }} <span class="arrow">→</span></a>
</div>
</div>
<div class="heroB__media" data-reveal data-reveal-delay="2">
<div class="carousel" id="heroCarousel" aria-roledescription="carrousel" aria-label="Photos de territoires">
<div class="carousel__track">{% for s in accueil.carrousel %}
<div class="carousel__slide ph ph--tall ph--filled"><img src="{{ s.image }}" alt="{{ s.alt }}" decoding="async"></div>{% endfor %}
</div>
{% if accueil.carrousel.length > 1 %}<button class="carousel__btn carousel__btn--prev" type="button" aria-label="Photo précédente"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 3L5 8l5 5"/></svg></button>
<button class="carousel__btn carousel__btn--next" type="button" aria-label="Photo suivante"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5"/></svg></button>
<div class="carousel__dots"></div>{% endif %}
</div>
</div>
</div>
</div>
</section>
<section class="role wrap">
<p class="eyebrow" data-reveal>{{ accueil.role_surtitre }}</p>
<p class="role__statement" data-reveal>{{ accueil.role_titre | fi | safe }}</p>
<div class="role__body" data-reveal data-reveal-delay="1">{{ accueil.role_texte | paras | safe }}</div>
</section>
<section class="band"><div class="wrap ctx__grid">
<div data-reveal><p class="eyebrow">{{ accueil.contexte_surtitre }}</p><h2 class="ctx__big">{{ accueil.contexte_titre | fi | safe }}</h2><p class="ctx__text">{{ accueil.contexte_texte | fi | safe }}</p><p class="ctx__end">{{ accueil.contexte_titre2 | fi | safe }}</p></div>
<div data-reveal data-reveal-delay="1">
<ul class="tens">{% for li in accueil.contexte_liste %}{% set pair = li.split(' & ') %}
<li class="ten"><span>{% if pair.length > 1 %}{{ pair[0] }}<span class="ten__amp">&amp;</span>{{ pair.slice(1).join(' & ') }}{% else %}{{ li }}{% endif %}</span></li>{% endfor %}
</ul>
</div>
</div></section>
<section class="xp wrap">
<div class="xp__head">
<div data-reveal><p class="eyebrow">{{ accueil.expertises_surtitre }}</p><h2 class="xp__title mt-s">{{ accueil.expertises_titre | fi | safe }}</h2></div>
<p class="ctx__text" data-reveal data-reveal-delay="1">{{ accueil.expertises_texte | fi | safe }}</p>
</div>
<div>{% for e in exp %}
<a class="xp-row" href="/{{ e.page }}.html" data-reveal><span class="xp-row__n">{{ e.num }}</span><span><span class="xp-row__t">{{ e.nom }}</span><span class="xp-row__d">{{ e.description | fi | safe }}</span></span><span class="xp-row__a"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--paper)" stroke-width="1.5"><path d="M3 13L13 3M13 3H5M13 3V11"/></svg></span></a>{% endfor %}
</div>
</section>
{% set derniers = collections.projets | recent('', 3) %}{% if derniers.length %}<section class="last wrap">
<div class="last__head"><div data-reveal><p class="eyebrow">Réalisations</p><h2 class="xp__title mt-s">Nos dernières <span class="bracket">[réalisations]</span></h2></div>
<a href="/realisations.html" class="btn" data-reveal>Autres réalisations <span class="arrow">→</span></a></div>
<div class="proj-grid">{% for r in derniers %}
<a class="card" href="/realisations/{{ r.data.slug }}.html" data-reveal>{% if r.data.image %}<img src="{{ r.data.image | img }}" alt="{{ r.data.titre }}" loading="lazy">{% endif %}<span class="card__arrow"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.5"><path d="M3 13L13 3M13 3H5M13 3V11"/></svg></span><span class="card__body"><span class="card__title">{{ r.data.titre }}</span><span class="card__client">{{ r.data.client }}</span></span></a>{% endfor %}
</div>
</section>{% endif %}
{% endblock %}
{% block scripts %}{% if accueil.carrousel.length > 1 %}{% raw %}<script>
(function(){
  var c=document.getElementById('heroCarousel'); if(!c) return;
  var track=c.querySelector('.carousel__track'), slides=c.querySelectorAll('.carousel__slide'), dots=c.querySelector('.carousel__dots'), i=0, n=slides.length;
  for(var k=0;k<n;k++){ var d=document.createElement('button'); d.type='button'; d.setAttribute('aria-label','Photo '+(k+1)); (function(k){d.addEventListener('click',function(){go(k);});})(k); dots.appendChild(d); }
  function go(k){ i=(k+n)%n; track.style.transform='translateX('+(-100*i)+'%)'; [].forEach.call(dots.children,function(d,j){d.setAttribute('aria-current', j===i?'true':'false');}); }
  c.querySelector('.carousel__btn--prev').addEventListener('click',function(){go(i-1);});
  c.querySelector('.carousel__btn--next').addEventListener('click',function(){go(i+1);});
  var x0=null; c.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
  c.addEventListener('touchend',function(e){ if(x0===null) return; var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>40) go(i+(dx<0?1:-1)); x0=null; });
  go(0);
  var t=null; function play(){ stop(); t=setInterval(function(){go(i+1);},5000); } function stop(){ if(t) clearInterval(t); t=null; }
  c.addEventListener('mouseenter',stop); c.addEventListener('mouseleave',play);
  [].forEach.call(c.querySelectorAll('button'),function(b){b.addEventListener('click',play);});
  document.addEventListener('visibilitychange',function(){ document.hidden?stop():play(); });
  play();
})();
</script>{% endraw %}{% endif %}{% endblock %}
