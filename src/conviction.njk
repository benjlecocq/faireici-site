---
permalink: "conviction.html"
navKey: "conviction"
bodyPage: "conviction"
---
{% extends "base.njk" %}
{% set seo = { titre: conviction.seo_titre, description: conviction.seo_description } %}
{% block style %}{% raw %}
.page-hero__title{font-size:clamp(2.4rem,5.4vw,4.6rem);max-width:18ch;line-height:1}
.cv-intro{padding-block:clamp(24px,3vw,48px) clamp(56px,7vw,96px)}
.cv-intro__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(36px,6vw,96px);align-items:start}
.cv-intro__title{font-family:var(--font-display);font-weight:500;font-size:clamp(1.6rem,2.8vw,2.4rem);line-height:1.14;letter-spacing:-0.025em;text-wrap:pretty;margin:0;color:var(--paper)}
.cv-intro__cols{display:flex;flex-direction:column;gap:22px;padding-top:.4em}
.cv-intro__cols p{margin:0;color:var(--paper-dim);font-size:clamp(1.05rem,1.3vw,1.2rem);line-height:1.6}
.cv-role{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,6vw,96px);align-items:start}
.cv-role__title{font-family:var(--font-display);font-weight:500;font-size:clamp(2rem,4vw,3.4rem);line-height:1.02;letter-spacing:-0.03em;margin-top:18px}
.cv-role__phrase{color:var(--paper-dim);font-size:clamp(1.05rem,1.3vw,1.2rem);line-height:1.55;margin-top:22px;max-width:40ch}
.cv-bullets{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.cv-bullets li{display:grid;grid-template-columns:28px 1fr;align-items:baseline;padding:18px 0;border-bottom:1px solid var(--line);font-family:var(--font-display);font-weight:500;font-size:clamp(1.1rem,1.5vw,1.35rem);letter-spacing:-0.015em;line-height:1.25;color:var(--paper)}
.cv-bullets li > span::first-letter{text-transform:uppercase}
.cv-bullets li::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);transform:translateY(-2px)}
.cv-method{padding-block:clamp(56px,7vw,100px)}
.cv-method__title{font-family:var(--font-display);font-weight:500;font-size:clamp(1.8rem,3.2vw,2.7rem);line-height:1.08;letter-spacing:-0.025em;max-width:24ch;margin-top:18px}
.frise{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(16px,2vw,32px);margin-top:clamp(36px,4.4vw,64px);position:relative}
.frise::before{content:"";position:absolute;left:0;right:0;top:clamp(76px,7.4vw,104px);height:2px;background:var(--accent)}
.fr__n{font-family:var(--font-display);font-weight:500;font-size:clamp(3rem,5.6vw,5rem);line-height:1;letter-spacing:-0.05em;color:var(--paper);display:block;height:clamp(68px,6.6vw,94px)}
.fr__dot{display:block;width:18px;height:18px;border-radius:50%;background:var(--ink);border:2px solid var(--accent);position:relative;margin-top:clamp(0px,.2vw,2px)}
.fr:first-child .fr__dot{background:var(--accent)}
.fr__t{font-family:var(--font-display);font-weight:500;font-size:clamp(1.2rem,1.6vw,1.45rem);letter-spacing:-0.02em;color:var(--accent);margin-top:22px;display:block}
.fr__d{color:var(--paper-dim);font-size:1rem;line-height:1.5;margin-top:10px}
@media (max-width:900px){.cv-intro__grid,.cv-role{grid-template-columns:1fr}.frise{grid-template-columns:1fr;gap:28px;padding-left:34px}.frise::before{left:8px;right:auto;top:0;bottom:0;width:2px;height:auto}.fr{position:relative}.fr__n{height:auto;font-size:2.6rem}.fr__dot{position:absolute;left:-34px;top:14px}.fr__t{margin-top:8px}}
{% endraw %}{% endblock %}
{% block main %}
<section class="page-hero wrap">
<p class="eyebrow" data-reveal>{{ conviction.surtitre }}</p>
<h1 class="page-hero__title mt-s" data-reveal data-reveal-delay="1">{{ conviction.titre | fi | safe }}</h1>
</section>
<section class="cv-intro wrap"><div class="cv-intro__grid">
<p class="cv-intro__title" data-reveal>{{ conviction.intro_titre | fi | safe }}</p>
<div class="cv-intro__cols" data-reveal data-reveal-delay="1">{% for ph in conviction.intro_phrases %}
<p>{{ ph | fi | safe }}</p>{% endfor %}
</div>
</div></section>
<section class="band"><div class="wrap cv-role">
<div data-reveal><p class="eyebrow">{{ conviction.role_surtitre }}</p><h2 class="cv-role__title">{{ conviction.role_titre | fi | safe }}</h2><p class="cv-role__phrase">{{ conviction.role_phrase | fi | safe }}</p></div>
<ul class="cv-bullets" data-reveal data-reveal-delay="1">{% for li in conviction.role_liste %}
<li><span>{{ li | fi | safe }}</span></li>{% endfor %}
</ul>
</div></section>
<section class="cv-method wrap">
<div data-reveal><p class="eyebrow">{{ conviction.methode_surtitre }}</p>
<h2 class="cv-method__title">{{ conviction.methode_titre | fi | safe }}</h2></div>
<div class="frise" data-reveal>{% for et in conviction.etapes %}
<div class="fr"><span class="fr__n">{{ "0" if loop.index < 10 }}{{ loop.index }}</span><span class="fr__dot"></span><span class="fr__t">{{ et.titre }}</span><p class="fr__d">{{ et.texte | fi | safe }}</p></div>{% endfor %}
</div>
</section>
{% endblock %}
