---
permalink: "conviction.html"
navKey: "conviction"
bodyPage: "conviction"
---
{% extends "base.njk" %}
{% set seo = { titre: conviction.seo_titre, description: conviction.seo_description } %}
{% block style %}{% raw %}
.cv-block{padding-block:clamp(40px,5vw,72px);}
.cv-head .h-lg{margin-top:14px;max-width:none;}
.cv-intro__title{font-family:var(--font-display);font-weight:500;font-size:clamp(1.5rem,2.2vw,1.9rem);line-height:1.16;letter-spacing:-0.02em;color:var(--paper);text-wrap:pretty;max-width:900px;}
.cv-intro__phrases{display:flex;flex-direction:column;gap:18px;margin-top:clamp(22px,3vw,36px);max-width:820px;}
.cv-intro__phrases p{margin:0;color:var(--paper-dim);font-size:1.0625rem;line-height:1.6;}
.cv-role__body{margin-top:clamp(22px,3vw,36px);max-width:820px;}
.cv-role__phrase{font-family:var(--font-display);font-weight:500;font-size:clamp(1.2rem,1.6vw,1.4rem);line-height:1.2;letter-spacing:-0.01em;color:var(--paper);margin:0 0 clamp(16px,2vw,24px);}
.cv-bullets{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px;}
.cv-bullets li{position:relative;padding-left:18px;font-family:var(--font-body);font-size:1.0625rem;line-height:1.5;color:var(--paper-dim);}
.cv-bullets li::first-letter{text-transform:uppercase;}
.cv-bullets li::before{content:"";position:absolute;left:0;top:0.62em;width:6px;height:6px;border-radius:50%;background:var(--accent);}
.cv-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:clamp(28px,3.5vw,44px);}
.cv-step{background:var(--ink-2);border-radius:14px;padding:clamp(20px,2vw,28px);display:flex;flex-direction:column;gap:10px;}
.cv-step__n{font-family:var(--font-mono);font-size:0.8rem;letter-spacing:0.1em;color:var(--accent);}
.cv-step__t{font-family:var(--font-display);font-weight:500;font-size:clamp(1.2rem,1.6vw,1.4rem);line-height:1.2;letter-spacing:-0.02em;color:var(--paper);margin-top:10px;}
.cv-step__d{color:var(--paper-dim);font-size:1rem;line-height:1.5;margin:0;}
@media (max-width:1000px){.cv-steps{grid-template-columns:repeat(2,minmax(0,1fr));}.cv-step:last-child:nth-child(odd){grid-column:1/-1;}}
@media (max-width:560px){.cv-steps{grid-template-columns:minmax(0,1fr);}.cv-step:last-child:nth-child(odd){grid-column:auto;}}
{% endraw %}{% endblock %}
{% block main %}
<section class="page-hero wrap">
<p class="eyebrow" data-reveal>{{ conviction.surtitre }}</p>
<h1 class="page-hero__title mt-s" data-reveal data-reveal-delay="1">{{ conviction.titre | fi | safe }}</h1>
</section>
<section class="wrap cv-block">
<div data-reveal><p class="cv-intro__title">{{ conviction.intro_titre | fi | safe }}</p></div>
<div class="cv-intro__phrases" data-reveal data-reveal-delay="1">{% for ph in conviction.intro_phrases %}
<p>{{ ph | fi | safe }}</p>{% endfor %}
</div>
</section>
<section class="wrap cv-block">
<div class="cv-head" data-reveal>
<p class="eyebrow">{{ conviction.role_surtitre }}</p>
<h2 class="h-lg">{{ conviction.role_titre | fi | safe }}</h2>
</div>
<div class="cv-role__body" data-reveal data-reveal-delay="1">
<p class="cv-role__phrase">{{ conviction.role_phrase | fi | safe }}</p>
<ul class="cv-bullets">{% for li in conviction.role_liste %}
<li>{{ li | fi | safe }}</li>{% endfor %}
</ul>
</div>
</section>
<section class="wrap cv-block">
<div class="cv-head" data-reveal>
<p class="eyebrow">{{ conviction.methode_surtitre }}</p>
<h2 class="h-lg">{{ conviction.methode_titre | fi | safe }}</h2>
</div>
<div class="cv-steps" data-reveal>{% for et in conviction.etapes %}
<div class="cv-step">
<span class="cv-step__n">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
<span class="cv-step__t">{{ et.titre }}</span>
<p class="cv-step__d">{{ et.texte | fi | safe }}</p>
</div>{% endfor %}
</div>
</section>
{% endblock %}
