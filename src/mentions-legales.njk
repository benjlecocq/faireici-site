{% extends "base.njk" %}
{% set seo = { titre: "Mentions légales - fair[e]ici", description: "Mentions légales et politique de protection des données personnelles du site fair[e]ici." } %}
{% block style %}{% raw %}
.contact-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(36px,6vw,90px); align-items: start; }
.intentions { display: flex; flex-wrap: wrap; gap: 12px; }
.chip { font-family: var(--font-mono); font-size: 0.84rem; letter-spacing: 0.02em; color: var(--paper-dim); border: 1px solid var(--line); border-radius: 999px; padding: 0.7em 1.15em; cursor: pointer; transition: border-color .25s var(--ease), color .25s var(--ease), background .25s var(--ease); user-select: none; display: inline-flex; align-items: center; gap: 8px; }
.chip::before { content: "+"; color: var(--accent); transition: transform .25s var(--ease); }
.chip:hover { border-color: var(--accent); color: var(--paper); }
.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
.chip[aria-pressed="true"]::before { content: "✓"; color: #fff; }

.field { display: grid; gap: 8px; margin-bottom: 20px; }
.field label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
.field label .req { color: var(--accent); }
.field input, .field textarea {
  font-family: var(--font-body); font-size: 1rem; color: var(--paper);
  background: var(--ink-2); border: 1px solid var(--line); border-radius: 10px;
  padding: 14px 16px; width: 100%; transition: border-color .25s var(--ease), background .25s var(--ease);
}
.field textarea { resize: vertical; min-height: 130px; }
.field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); background: var(--ink-3); }
.field input::placeholder, .field textarea::placeholder { color: var(--muted); }
.field.invalid input, .field.invalid textarea { border-color: var(--accent); }
.field .err { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--accent); display: none; }
.field.invalid .err { display: block; }
.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.form-submit { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 8px; }
.form-note { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; color: var(--muted); }

.form-success { display: none; border: 1px solid var(--accent); border-radius: 16px; padding: clamp(28px,4vw,48px); background: var(--ink-2); }
.form-success.show { display: block; }
.form-card.hide { display: none; }
.form-success .tick { width: 52px; height: 52px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; color: #fff; font-size: 1.4rem; margin-bottom: 20px; }

.contact-info { display: grid; gap: 4px; }
.contact-info a.big { font-family: var(--font-body); font-weight: 500; font-size: clamp(1rem,1.15vw,1.1rem); letter-spacing: 0; color: var(--paper-dim); transition: color .25s var(--ease); }
.contact-info a.big:hover { color: var(--accent); }
.contact-addr { font-family: var(--font-body); font-size: clamp(1rem,1.15vw,1.1rem); line-height: 1.5; color: var(--paper-dim); max-width: 22ch; }

@media (max-width: 900px){ .contact-grid { grid-template-columns: 1fr; } .row-2 { grid-template-columns: 1fr; } }
.legal{max-width:760px;}
.legal h2{font-family:var(--font-mono);font-weight:400;font-size:0.74rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--accent);margin:clamp(32px,4vw,44px) 0 12px;}
.legal h2:first-child{margin-top:0;}
.legal p,.legal li{color:var(--paper-dim);font-size:1rem;line-height:1.65;}
.legal p + p{margin-top:0.6em;}
.legal ol,.legal ul{padding-left:1.2em;display:grid;gap:8px;margin-top:8px;}
.legal a{color:var(--paper);border-bottom:1px solid var(--line);}
.legal a:hover{color:var(--accent);border-color:var(--accent);}
.legal strong{color:var(--paper);font-weight:500;}
{% endraw %}{% endblock %}
